# Ambiente de execução (local, staging, production)
APP_ENV=local

# Nível de detalhe dos logs (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Tamanho máximo de upload em megabytes
MAX_UPLOAD_MB=200

# Pastas de trabalho (caminhos relativos à raiz do projeto)
LIBRARY_DIR=data/library
UPLOADS_DIR=data/uploads
OUTPUT_DIR=data/output

# Acima desta quantidade de caracteres, a conversão para Markdown mostra um aviso de tamanho
LARGE_OUTPUT_WARNING_CHARS=500000


# ---------- OCR (reconhecimento de texto em PDFs escaneados) ----------
# Liga ou desliga o OCR (true ou false)
OCR_ENABLED=true
# Idiomas separados por "+" (cada um precisa de um arquivo .traineddata em TESSDATA_DIR)
OCR_LANGUAGES=por+eng
# Resolução usada para "fotografar" cada página (maior = mais preciso e mais lento)
OCR_DPI=300
# Páginas com menos caracteres que isto são consideradas escaneadas e passam pelo OCR
OCR_MIN_TEXT_CHARS=20
# Pasta com os arquivos de idioma
TESSDATA_DIR=data/tessdata